# Copy to tools/pi.env (gitignored) and fill in.
# Anything ssh understands: a hostname, user@host, or a ~/.ssh/config alias.
PI_HOST=forest@uk-ebike.internal

# Where the capture code lives on the Pi. Recordings do NOT go here -- they go
# wherever config/capture.toml says, deliberately outside this directory, so
# that deploy.sh's --delete can never reach a recording.
PI_DIR=/home/forest/bikelog

# Where the `bikelog` shim is installed. Must be on the Pi's PATH.
# Leave it unset and deploy.sh asks the Pi for $HOME/.local/bin.
PI_BIN=/home/forest/.local/bin

# Optional. deploy.sh probes $HOME/.local/bin, $HOME/.cargo/bin, /usr/local/bin
# and /usr/bin for uv, because `ssh host command` does not source .bashrc and so
# runs with no ~/.local/bin on its PATH. Set this only if uv lives elsewhere.
# PI_UV=/home/forest/.local/bin/uv
